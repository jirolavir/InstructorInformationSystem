@model IEnumerable<InstructorInfoSystem.Models.Instructor>

@{
    ViewData["Title"] = "Instructors";

    var currentSort = ViewData["CurrentSort"]?.ToString();
    var currentFilter = ViewData["CurrentFilter"]?.ToString();
    var currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 0);

    string NextSort(string column) => currentSort == column ? column + "_desc" : column;
    string Arrow(string column) => currentSort == column ? " ↑" : (currentSort == column + "_desc" ? " ↓" : "");
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="page-title mb-0">Instructors</h1>
        <small class="text-muted">
            Showing @Model.Count() of @ViewData["TotalCount"] instructors
        </small>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Add Instructor</a>
</div>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-12 col-md-8 col-lg-6">
            <input type="text"
                   name="searchString"
                   value="@currentFilter"
                   class="form-control"
                   placeholder="Search by name, designation, majorship, degree, address, or e-mail..." />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="table-card">
    <table class="table instructor-table align-middle">
        <thead>
            <tr>
                <th>
                    <a asp-action="Index" asp-route-searchString="@currentFilter" asp-route-sortOrder="@NextSort("fullName")">Full Name @Arrow("fullName")</a>
                </th>
                <th>Age</th>
                <th>Address</th>
                <th>
                    <a asp-action="Index" asp-route-searchString="@currentFilter" asp-route-sortOrder="@NextSort("designation")">Designation @Arrow("designation")</a>
                </th>
                <th>Gender</th>
                <th>Contact Number</th>
                <th>Majorship</th>
                <th>Bachelor Degree</th>
                <th>
                    <a asp-action="Index" asp-route-searchString="@currentFilter" asp-route-sortOrder="@NextSort("email")">E-mail Address @Arrow("email")</a>
                </th>
                <th class="text-center" style="min-width: 310px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var instructor in Model)
                {
                    <tr>
                        <td class="fw-semibold">@instructor.FullName</td>
                        <td>@instructor.Age</td>
                        <td class="wrap">@instructor.Address</td>
                        <td>@instructor.Designation</td>
                        <td>@instructor.Gender</td>
                        <td>@instructor.ContactNumber</td>
                        <td>@instructor.Majorship</td>
                        <td class="wrap">@instructor.BachelorDegree</td>
                        <td><a href="mailto:@instructor.Email" class="email-link">@instructor.Email</a></td>
                        <td class="text-center actions-cell">
                            <div class="instructor-actions">
                            <a href="mailto:@instructor.Email" class="btn-action btn-action-compose">Compose</a>
                            <a asp-action="Details" asp-route-id="@instructor.InstructorId" class="btn-action btn-action-view">Details</a>
                            <a asp-action="Edit" asp-route-id="@instructor.InstructorId" class="btn-action btn-action-edit">Edit</a>
                            <a asp-action="Delete" asp-route-id="@instructor.InstructorId" class="btn-action btn-action-delete">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-4">
                        No instructors found. Add an instructor to get started.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav aria-label="Instructor pages" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-searchString="@currentFilter"
                   asp-route-sortOrder="@currentSort" asp-route-page="@(currentPage - 1)">Previous</a>
            </li>

            @for (var p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-searchString="@currentFilter"
                       asp-route-sortOrder="@currentSort" asp-route-page="@p">@p</a>
                </li>
            }

            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-searchString="@currentFilter"
                   asp-route-sortOrder="@currentSort" asp-route-page="@(currentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
