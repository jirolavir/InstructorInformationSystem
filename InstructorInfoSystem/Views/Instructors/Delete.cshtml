@model InstructorInfoSystem.Models.Instructor

@{
    ViewData["Title"] = "Delete Instructor";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm overflow-hidden">
                <div class="form-card-header danger">
                    <h4 class="mb-0 fw-bold">Delete Instructor</h4>
                </div>

                <div class="card-body p-4">
                   

                    <dl class="row">
                        <dt class="col-sm-4">Instructor ID</dt>
                        <dd class="col-sm-8">@Model.InstructorId</dd>

                        <dt class="col-sm-4">Full Name</dt>
                        <dd class="col-sm-8">@Model.FullName</dd>

                        <dt class="col-sm-4">Designation</dt>
                        <dd class="col-sm-8">@Model.Designation</dd>

                        <dt class="col-sm-4">Contact Number</dt>
                        <dd class="col-sm-8">@Model.ContactNumber</dd>

                        <dt class="col-sm-4">E-mail Address</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                    </dl>

                    <div class="alert alert-warning border-0 rounded-3">
                        
                        Are you sure you want to delete
                        <strong>@Model.FullName</strong>?
                        This action cannot be undone.
                    </div>

                    
                <form asp-action="Delete"
                        asp-route-id="@Model.InstructorId"
                        method="post"
                        onsubmit="return confirm('Are you sure you want to permanently delete this instructor?');">
                                @Html.AntiForgeryToken()


                        <input type="hidden"
                               name="id"
                               value="@Model.InstructorId" />

                        <button type="submit" class="btn btn-solid-delete">
                            Confirm Delete
                        </button>
                        <a asp-controller="Instructors"
                           asp-action="Index"
                           class="btn btn-outline-secondary ms-2">
                            Cancel
                        </a>

                        
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
