@{
    ViewData["Title"] = "Dashboard";
    var totalInstructors = (int)ViewBag.TotalInstructors;
    var firstName = User.FindFirst("FirstName")?.Value;
    var lastName = User.FindFirst("LastName")?.Value;
}

<div class="dashboard-heading">
    <div>
        <span class="eyebrow">OVERVIEW</span>
        <h1 class="page-title mb-1">Dashboard</h1>
        <p class="text-muted mb-0">Manage your instructor records in one place.</p>
    </div>
    <div class="today-chip"><i class="bi bi-calendar3"></i> @DateTime.Now.ToString("MMMM dd, yyyy")</div>
</div>

<section class="welcome-banner mb-4">
    <div class="welcome-copy">
        <span class="welcome-label">INSTRUCTOR INFORMATION SYSTEM</span>
        <h2>Welcome back, @firstName!</h2>
        <p>Here’s a quick overview of your instructor information system.</p>
    </div>
    <div class="welcome-art" aria-hidden="true"><i class="bi bi-mortarboard-fill"></i></div>
    <span class="banner-orb banner-orb-one"></span>
    <span class="banner-orb banner-orb-two"></span>
</section>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-6 col-xl-4">
        <div class="stat-card stat-primary">
            <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
            <div>
                <div class="stat-label">Total Instructors</div>
                <div class="stat-number">@totalInstructors</div>
                <a asp-controller="Instructors" asp-action="Index">View all records <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <div class="stat-card stat-lavender">
            <div class="stat-icon"><i class="bi bi-person-plus-fill"></i></div>
            <div>
                <div class="stat-label">Add a New Instructor</div>
                <div class="stat-description">Create and save an instructor record.</div>
                <a asp-controller="Instructors" asp-action="Create">Add instructor <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <div class="stat-card stat-yellow">
            <div class="stat-icon"><i class="bi bi-clipboard-data-fill"></i></div>
            <div>
                <div class="stat-label">Record Management</div>
                <div class="stat-description">Search, view, update, or remove records.</div>
                <a asp-controller="Instructors" asp-action="Index">Manage records <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-7">
        <section class="panel-card h-100">
            <div class="panel-heading">
                <div>
                    <span class="eyebrow">GET STARTED</span>
                    <h5>Quick Actions</h5>
                </div>
                <span class="heading-icon"><i class="bi bi-lightning-charge-fill"></i></span>
            </div>
            <div class="quick-action-list">
                <a asp-controller="Instructors" asp-action="Create" class="quick-action">
                    <span class="quick-action-icon purple"><i class="bi bi-plus-lg"></i></span>
                    <span><strong>Add Instructor</strong><small>Create a new instructor profile</small></span>
                    <i class="bi bi-chevron-right ms-auto"></i>
                </a>
                <a asp-controller="Instructors" asp-action="Index" class="quick-action">
                    <span class="quick-action-icon blue"><i class="bi bi-search"></i></span>
                    <span><strong>Browse Instructors</strong><small>Find and manage saved records</small></span>
                    <i class="bi bi-chevron-right ms-auto"></i>
                </a>
                <a asp-controller="Account" asp-action="Profile" class="quick-action">
                    <span class="quick-action-icon gold"><i class="bi bi-person-gear"></i></span>
                    <span><strong>My Profile</strong><small>Review your account information</small></span>
                    <i class="bi bi-chevron-right ms-auto"></i>
                </a>
            </div>
        </section>
    </div>
    <div class="col-12 col-lg-5">
        <section class="panel-card h-100">
            <div class="panel-heading">
                <div>
                    <span class="eyebrow">ACCOUNT</span>
                    <h5>Your Information</h5>
                </div>
                <span class="heading-icon"><i class="bi bi-person-badge-fill"></i></span>
            </div>
            <div class="profile-summary">
                <div class="profile-avatar"><i class="bi bi-person-fill"></i></div>
                <div><strong>@firstName @lastName</strong><small>Signed-in account</small></div>
            </div>
            <div class="profile-detail"><span>Email address</span><strong>@User.Identity?.Name</strong></div>
            <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-primary w-100 mt-3">View My Profile <i class="bi bi-arrow-up-right ms-1"></i></a>
        </section>
    </div>
</div>
