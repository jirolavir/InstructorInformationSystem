@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-5 mb-5" style="max-width: 800px;">

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary text-white p-4">
            <h2 class="mb-1">My Profile</h2>
            <p class="mb-0">
                View your registered account information.
            </p>
        </div>

        <div class="card-body p-4">

            <div class="text-center mb-4">
                <div class="rounded-circle bg-primary text-white d-inline-flex
                    align-items-center justify-content-center"
                     style="width: 90px; height: 90px; font-size: 36px;">
                    @ViewBag.FirstName?.ToString().Substring(0, 1).ToUpper()
                </div>

                <h3 class="mt-3">
                    @ViewBag.FirstName @ViewBag.LastName
                </h3>

                <p class="text-muted mb-0">
                    Registered User
                </p>
            </div>

            <hr />

            <h5 class="mb-3">Account Information</h5>

            <div class="row mb-3">
                <div class="col-sm-4 fw-bold">Account ID</div>
                <div class="col-sm-8">@ViewBag.AccountId</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4 fw-bold">First Name</div>
                <div class="col-sm-8">@ViewBag.FirstName</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4 fw-bold">Last Name</div>
                <div class="col-sm-8">@ViewBag.LastName</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4 fw-bold">Email Address</div>
                <div class="col-sm-8">@ViewBag.Email</div>
            </div>

            <hr />

            <div class="alert alert-info mb-4">
                <strong>Account Security</strong>
                <p class="mb-0 mt-1">
                    Your password is stored as a secure hash and is
                    not displayed on this page.
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to Dashboard
                </a>

                <a asp-controller="Instructors"
                   asp-action="Index"
                   class="btn btn-primary">
                    Manage Instructors
                </a>
            </div>

        </div>
    </div>

</div>
